# ===========================================
# Peony Application - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# ==================== Database Configuration ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=peony
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Use this for Docker Compose (optional - overrides above):
# POSTGRES_URL=jdbc:postgresql://localhost:5432/peony

# ==================== PlantNet API Configuration ====================
# Leave empty to use the free public tier (5 requests/minute)
# OR set your API key for higher rate limits
PLANTNET_API_KEY=

# ==================== JWT Configuration ====================
# REQUIRED in every real environment: the secret used to sign access/refresh tokens
# (spec #17). The local and test profiles supply a development secret; all other
# environments must set a strong random value here or the app refuses to start.
JWT_SECRET=
# Token lifetimes (Spring duration format, e.g. 30m, 1h, 30d). Defaults shown.
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=30d

# ==================== CORS Configuration ====================
# Browser CORS allowlist (issue #24), comma-separated origins.
# Empty (the default) disables CORS: no cross-origin browser client is allowed.
# The local profile already allows the Expo web dev server at http://localhost:8081.
# Production should set its real web-app origin. Until the domain is chosen, the
# documented placeholder is:
# PEONY_CORS_ALLOWED_ORIGINS=https://app.peony.example.com
PEONY_CORS_ALLOWED_ORIGINS=

# ==================== Application Configuration ====================
PORT=8080                    # Server port (inside the container)
HOST_PORT=8080               # Host port the app is published on (docker compose only)
