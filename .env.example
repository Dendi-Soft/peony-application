# ===========================================
# Peony Application - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# ==================== Database Configuration ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=peony
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Use this for Docker Compose (optional - overrides above):
# POSTGRES_URL=jdbc:postgresql://localhost:5432/peony
# ==================== PlantNet API Configuration ====================
# Leave empty to use the free public tier (5 requests/min)
# OR set your API key for higher rate limits
PLANTNET_API_KEY=

# ==================== Caching Configuration ====================
CACHE_EXPIRE_MINUTES=60      # Cache TTL in minutes (default: 60)
CACHE_ACCESS_TTL_MINUTES=30  # Cache access time-to-live in minutes (default: 30)

# ==================== Redis Configuration (optional) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ==================== Application Configuration ====================
PORT=8080                    # Server port
APP_DEBUG_MODE=true          # Enable debug mode in local development
